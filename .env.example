# Copy to .env in the project root: cp .env.example .env
# Read by both walkthroughs: R with readRenviron(".env"), Python with python-dotenv.
# No secrets go here: credentials come from Workbench, Connect, or the Databricks CLI.

# SQL warehouse: Databricks UI > SQL Warehouses > (warehouse) > Connection details > HTTP path
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/<warehouse-id>

# Set automatically on Posit Workbench when you start a session with Databricks credentials.
# Uncomment only on a laptop.
# DATABRICKS_HOST=https://adb-1234567890123456.12.azuredatabricks.net
